THROTTLEFORGE_API_ORIGIN=http://127.0.0.1:3000

# Demonstration probe. Unset or enabled runs it in development.
# disabled turns it off. Production runs it only when this is exactly enabled.
# THROTTLEFORGE_DEMO_PROBE=disabled

# Browser-visible origin for a proxied or production deployment.
# Required in production before the probe will call the API.
# Do not use forwarded headers in place of this value.
# THROTTLEFORGE_CANONICAL_ORIGIN=https://demo.example.com
